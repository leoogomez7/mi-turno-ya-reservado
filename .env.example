# Mi Turno Ya — variables para el proyecto raíz.
# Copiar a .env.local para desarrollo; cargar los valores equivalentes en Vercel.

# Kinde — públicas para iniciar los flujos de inicio de sesión y registro.
VITE_KINDE_DOMAIN=tu-tenant.kinde.com
VITE_KINDE_CLIENT_ID=tu-kinde-client-id
VITE_KINDE_ORG_CODE=
VITE_KINDE_CONNECTION_ID=

# Kinde y Turso — solo servidor / Vercel. No agregar el prefijo VITE_.
KINDE_ISSUER_URL=https://tu-tenant.kinde.com
KINDE_CLIENT_ID=tu-kinde-client-id
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=REEMPLAZAR_CON_TOKEN_PRIVADO

# Código privado de invitación de administrador (no usar prefijo VITE_).
# Elegí un valor largo y aleatorio; compartilo solo con administradores.
ADMIN_INVITE_CODE=

# Mercado Pago — token secreto, solo servidor.
MERCADOPAGO_ACCESS_TOKEN=REEMPLAZAR_CON_ACCESS_TOKEN_PRIVADO

# URL pública para los retornos del checkout.
PUBLIC_APP_URL=https://tu-dominio.com

# Datos de transferencia visibles al cliente.
VITE_TRANSFER_HOLDER=Nombre del titular
VITE_TRANSFER_BANK=Nombre del banco
VITE_TRANSFER_CBU=0000000000000000000000
VITE_TRANSFER_ALIAS=alias.de.ejemplo