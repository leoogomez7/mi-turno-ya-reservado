# Token privado: configurar en Vercel como variable de entorno (no usar prefijo VITE_).
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REEMPLAZAR_EN_VERCEL

# URL pública para los retornos del checkout.
PUBLIC_APP_URL=https://tu-dominio.com

# Datos de transferencia visibles al cliente.
VITE_TRANSFER_HOLDER=Nombre del titular
VITE_TRANSFER_BANK=Nombre del banco
VITE_TRANSFER_CBU=0000000000000000000000
VITE_TRANSFER_ALIAS=alias.de.ejemplo